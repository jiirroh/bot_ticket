# Token du bot Discord (seule variable obligatoire !)
# Obtenu sur https://discord.com/developers/applications (Onglet Bot -> Reset Token)
DISCORD_TOKEN=votre_token_bot_ici

# Optionnel : ID du ou des serveurs séparés par une virgule pour un rechargement immédiat en développement
# Laissez vide pour un enregistrement automatique sur tous vos serveurs
GUILD_ID=
