# Token d'authentification du bot Discord (obtenu sur le portail développeur Discord)
DISCORD_TOKEN=votre_token_bot_ici

# Identifiant client de l'application Discord (Application ID)
CLIENT_ID=votre_client_id_ici

# Optionnel : ID du serveur pour un déploiement instantané des commandes slash (laisser vide pour déploiement global)
GUILD_ID=
